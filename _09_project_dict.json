{
 "schema_version": "1.0",
 "updated_at": "2026-10-06T15:30:00+08:00",
 "terms": [
  {
   "term": "血压记录",
   "code_name": "BpRecord",
   "definition": "一次血压测量结果：高压/低压/脉搏、时间、测量臂、体位、备注、来源",
   "aliases": [
    "血压条目",
    "测量记录"
   ],
   "domain": "records"
  },
  {
   "term": "测量提醒",
   "code_name": "Reminder",
   "definition": "通过本地通知提醒用户测量血压的功能总称，支持多种提醒方式",
   "aliases": [
    "血压提示",
    "测量通知"
   ],
   "domain": "settings"
  },
  {
   "term": "提醒方式",
   "code_name": "ReminderMode",
   "definition": "测量提醒的触发模式枚举：off（关闭）/ daily（每日定时）/ interval（周期提醒）",
   "aliases": [
    "提醒类型",
    "提醒模式"
   ],
   "domain": "settings"
  },
  {
   "term": "定时提醒",
   "code_name": "DailyReminder",
   "definition": "提醒方式之一：每天固定时刻触发一次本地通知",
   "aliases": [
    "每日提醒",
    "固定时间提醒"
   ],
   "domain": "settings"
  },
  {
   "term": "周期提醒",
   "code_name": "IntervalReminder",
   "definition": "提醒方式之一：在开始时间与结束时间构成的提醒窗口内，按固定提醒周期（分钟）重复触发本地通知",
   "aliases": [
    "循环提醒",
    "间隔提醒"
   ],
   "domain": "settings"
  },
  {
   "term": "提醒窗口",
   "code_name": "reminderWindow",
   "definition": "周期提醒的生效时段，由开始时刻与结束时刻（均为当日时刻，要求 start < end）构成",
   "aliases": [
    "提醒时段",
    "生效时段"
   ],
   "domain": "settings"
  },
  {
   "term": "提醒周期",
   "code_name": "intervalMinutes",
   "definition": "周期提醒相邻两次触发的间隔分钟数（≥15），默认 30",
   "aliases": [
    "提醒间隔",
    "重复周期"
   ],
   "domain": "settings"
  },
  {
   "term": "触发时刻",
   "code_name": "occurrence",
   "definition": "按提醒窗口与提醒周期计算出的具体某天某时刻的通知触发点，从窗口开始时刻起按提醒周期递增，最后一个不晚于结束时刻",
   "aliases": [
    "触发点",
    "排程时刻"
   ],
   "domain": "settings"
  },
  {
   "term": "七段码",
   "code_name": "SevenSegment",
   "definition": "血压计 LCD 的七段数码管字形；巨型定制字形是通用 OCR 检测/识别模型的盲区，走专用结构化读取路径",
   "aliases": [
    "七段数码管",
    "段码屏"
   ],
   "domain": "camera_ocr"
  },
  {
   "term": "七段码读取器",
   "code_name": "SevenSegmentReader",
   "definition": "纯 Dart 的七段码读数引擎：背光定位→矫正→照度归一化二值化→行带/列簇提取→行列填充峰值分类→数字分组",
   "aliases": [
    "LCD 读取器"
   ],
   "domain": "camera_ocr"
  },
  {
   "term": "背光定位",
   "code_name": "locateLcdQuad",
   "definition": "用 HSV 饱和蓝/青掩码找到 LCD 旋转矩形四角（图像坐标锚定防颠倒），仅适用彩色背光屏；灰屏走通用 OCR 兜底",
   "aliases": [
    "LCD 定位"
   ],
   "domain": "camera_ocr"
  },
  {
   "term": "行带",
   "code_name": "LcdBand",
   "definition": "矫正后 LCD 里一行数字的横向条带，由行投影切分；行内再按列簇与行子块聚出单个字形",
   "aliases": [
    "显示行"
   ],
   "domain": "camera_ocr"
  }
 ]
}